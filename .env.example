# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# ---- LLM (scenario/label writer, via the OpenAI SDK) ------------------------
# Required for data generation (scripts 02, 05). Works with OpenAI or any
# OpenAI-compatible endpoint — set OPENAI_BASE_URL to point elsewhere.
#
# Krutrim Gemma-4-31B (default in configs/data_gen.yaml):
OPENAI_API_KEY=your_krutrim_api_key_here
OPENAI_BASE_URL=https://cloud.olakrutrim.com/v1
#
# OpenAI / other providers:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1        # e.g. Sarvam v2 / vLLM / Together

# ---- Soniox TTS (USER audio synthesis) --------------------------------------
# Required for script 03 (render_user_audio). Only the user side is synthesised.
SONIOX_API_KEY=your_soniox_api_key_here

# ---- Hugging Face -----------------------------------------------------------
# Required to pull Gemma-3-270M weights (gated) for Phase-1/2 training + inference.
# ALSO required for scripts/P1_01_fetch_corpus.py's Common Voice source (gated) — you
# additionally need to click "Agree and access repository" ONCE at
# https://huggingface.co/datasets/mozilla-foundation/common_voice_17_0 (a browser
# click, not something this token alone can do). The other Phase-1 sources
# (AI4Bharat Kathbath/Shrutilipi, Google FLEURS, IndicTTS) are ungated.
HF_TOKEN=hf_...
# Optional: where to push/pull the built corpus.
# HF_DATASET_ID=inavlabs/kupe-thinkspark-v2-350m

WANDB_API_KEY=<wandb_api_key>
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True